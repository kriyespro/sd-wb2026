<form id="job-apps-filters"
      hx-get="{{ url('operations:job_applications') }}"
      hx-target="#job-apps-panel"
      hx-swap="innerHTML"
      hx-push-url="true"
      hx-trigger="change, submit"
      class="mb-5 space-y-3">
    <div class="flex flex-wrap gap-2">
        <button type="submit" name="status" value=""
                class="ops-chip {{ 'border-ink-900 bg-ink-900 text-white' if not selected_status else '' }}">
            <span class="opacity-70">All</span>
            <span class="font-bold">{{ total_count }}</span>
        </button>
        {% for value, label in status_choices %}
        <button type="submit" name="status" value="{{ value }}"
                class="ops-chip
                {% if selected_status == value %}
                    {% if value == 'hired' %}border-emerald-600 bg-emerald-600 text-white
                    {% elif value == 'interview' %}border-amber-600 bg-amber-600 text-white
                    {% elif value == 'rejected' %}border-slate-600 bg-slate-600 text-white
                    {% else %}border-violet-600 bg-violet-600 text-white{% endif %}
                {% else %}
                    {% if value == 'new' %}border-violet-200 bg-violet-50 text-violet-800
                    {% elif value == 'hired' %}border-emerald-200 bg-emerald-50 text-emerald-800
                    {% elif value == 'interview' %}border-amber-200 bg-amber-50 text-amber-800
                    {% elif value == 'rejected' %}border-slate-200 bg-slate-50 text-slate-600
                    {% endif %}
                {% endif %}">
            <span class="opacity-70">{{ label }}</span>
            <span class="font-bold">{{ status_counts[value] }}</span>
        </button>
        {% endfor %}
    </div>

    <div class="flex flex-wrap items-center gap-2">
        <input type="text" name="q" value="{{ search_query }}" placeholder="Search name, email, phone…"
               hx-get="{{ url('operations:job_applications') }}"
               hx-target="#job-apps-panel"
               hx-swap="innerHTML"
               hx-push-url="true"
               hx-include="closest form"
               hx-trigger="keyup changed delay:400ms, search"
               class="ops-select w-56">

        <select name="role" class="ops-select w-auto">
            <option value="">All roles</option>
            {% for r in role_choices %}
            <option value="{{ r }}" {% if selected_role == r %}selected{% endif %}>{{ r }}</option>
            {% endfor %}
        </select>

        <select name="type" class="ops-select w-auto">
            <option value="">All types</option>
            {% for value, label in type_choices %}
            <option value="{{ value }}" {% if selected_type == value %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
        </select>

        {% if has_filters %}
        <a href="{{ url('operations:job_applications') }}"
           hx-get="{{ url('operations:job_applications') }}"
           hx-target="#job-apps-panel"
           hx-swap="innerHTML"
           hx-push-url="true"
           class="text-xs font-bold text-brand-600 hover:text-brand-700">Clear filters ×</a>
        {% endif %}

        <span class="text-xs text-slate-500">{{ filtered_count }} of {{ total_count }}</span>
    </div>
</form>

{% if applications %}
<div class="dash-panel overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full min-w-[960px] text-left text-sm">
            <thead class="border-b border-slate-100 bg-slate-50/80 text-xs uppercase tracking-[0.14em] text-slate-500">
                <tr>
                    <th class="px-5 py-3.5 font-semibold">Applicant</th>
                    <th class="px-4 py-3.5 font-semibold">Role</th>
                    <th class="px-4 py-3.5 font-semibold">Type</th>
                    <th class="px-4 py-3.5 font-semibold">Experience</th>
                    <th class="px-4 py-3.5 font-semibold">Links</th>
                    <th class="px-4 py-3.5 font-semibold">Applied</th>
                    <th class="px-4 py-3.5 font-semibold">Status</th>
                    <th class="px-5 py-3.5 font-semibold">Cover letter</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                {% for app in applications %}
                {% include "partials/ops/_job_application_row.jinja" %}
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% include "components/pagination.jinja" %}
{% else %}
<div class="dash-panel p-12 text-center">
    <p class="font-display text-lg font-semibold text-ink-900">No job applications match these filters</p>
    <p class="mt-2 text-sm text-slate-500">
        {% if has_filters %}
        Try clearing filters, or check
        {% else %}
        Submissions from
        {% endif %}
        <a href="{{ url('website:careers') }}" class="font-semibold text-brand-600 hover:underline">/careers/</a>.
    </p>
</div>
{% endif %}

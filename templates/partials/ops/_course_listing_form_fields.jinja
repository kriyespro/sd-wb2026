{% if show_errors and form.errors %}
<div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
    Please fix the highlighted fields and try again.
</div>
{% endif %}

<div class="grid gap-3 sm:grid-cols-2">
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Title</label>
        {{ form.title }}
        {% if show_errors %}{% for e in form.title.errors %}<p class="mt-1 text-xs text-red-600">{{ e }}</p>{% endfor %}{% endif %}
    </div>
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Price</label>
        {{ form.price }}
        {% if show_errors %}{% for e in form.price.errors %}<p class="mt-1 text-xs text-red-600">{{ e }}</p>{% endfor %}{% endif %}
    </div>
</div>

<div>
    <label class="mb-1 block text-xs font-semibold text-slate-600">Goal</label>
    {{ form.goal }}
    {% if show_errors %}{% for e in form.goal.errors %}<p class="mt-1 text-xs text-red-600">{{ e }}</p>{% endfor %}{% endif %}
</div>

<div class="grid gap-3 sm:grid-cols-4">
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Level</label>
        {{ form.level }}
    </div>
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Duration</label>
        {{ form.duration }}
    </div>
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Format</label>
        {{ form.format }}
    </div>
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Image URL</label>
        {{ form.image }}
    </div>
</div>

<div class="grid gap-3 sm:grid-cols-4">
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Modules count</label>
        {{ form.modules_count }}
    </div>
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Topics count</label>
        {{ form.topics_count }}
    </div>
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Salary range</label>
        {{ form.salary_range }}
    </div>
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Sort order</label>
        {{ form.sort_order }}
    </div>
</div>

<div class="grid gap-3 sm:grid-cols-2">
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Gains</label>
        {{ form.gains }}
    </div>
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Includes</label>
        {{ form.includes }}
    </div>
</div>

<div class="grid gap-3 sm:grid-cols-2">
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Learn modules (short list, shown on cards)</label>
        {{ form.learn_modules }}
    </div>
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Ideal career paths</label>
        {{ form.ideal_paths }}
    </div>
</div>

<div>
    <label class="mb-1 block text-xs font-semibold text-slate-600">Overview paragraphs</label>
    {{ form.overview }}
</div>

<div>
    <label class="mb-1 block text-xs font-semibold text-slate-600">Curriculum</label>
    {{ form.curriculum }}
    <p class="mt-1 text-xs text-slate-400">{{ form.curriculum.help_text }}</p>
</div>

<div>
    <label class="mb-1 block text-xs font-semibold text-slate-600">Student reviews</label>
    {{ form.reviews }}
    <p class="mt-1 text-xs text-slate-400">{{ form.reviews.help_text }}</p>
</div>

<div class="grid gap-3 sm:grid-cols-3">
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Career label</label>
        {{ form.career_label }}
    </div>
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Career min</label>
        {{ form.career_min }}
    </div>
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Career max</label>
        {{ form.career_max }}
    </div>
</div>

<div class="grid gap-3 sm:grid-cols-2">
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Highlight quote</label>
        {{ form.highlight_quote }}
    </div>
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Highlight author</label>
        {{ form.highlight_author }}
    </div>
</div>

<div class="grid gap-3 sm:grid-cols-4">
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Starts with</label>
        {{ form.starts_with }}
    </div>
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Enrolled count</label>
        {{ form.enrolled }}
    </div>
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Rating</label>
        {{ form.rating }}
    </div>
    <div>
        <label class="mb-1 block text-xs font-semibold text-slate-600">Reviews count</label>
        {{ form.reviews_count }}
    </div>
</div>

<div class="flex flex-wrap items-center gap-4">
    <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
        {{ form.featured }} Featured
    </label>
    <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
        {{ form.is_active }} Live on courses page
    </label>
</div>

<div id="job-apply-form-container" class="rounded-2xl border border-amber-200 bg-amber-50 p-8 text-center">
    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-amber-500 text-xl text-white">!</div>
    <h3 class="mt-4 font-display text-xl font-bold text-ink-900">You've already applied</h3>
    <p class="mt-2 text-sm text-slate-600">
        We found an existing application from you for <strong>{{ application.role }}</strong>, submitted
        {{ application.created_at.strftime('%d %b %Y') }}. We keep one active application per candidate —
        our team will reach out on that one, no need to resubmit.
    </p>
</div>

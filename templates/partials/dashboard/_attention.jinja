{% set tone_map = {
    'emerald': 'bg-emerald-100 text-emerald-700 ring-1 ring-emerald-200 hover:bg-emerald-200',
    'amber': 'bg-amber-100 text-amber-700 ring-1 ring-amber-200 hover:bg-amber-200',
    'orange': 'bg-orange-100 text-orange-700 ring-1 ring-orange-200 hover:bg-orange-200',
    'rose': 'bg-rose-100 text-rose-700 ring-1 ring-rose-200 hover:bg-rose-200',
    'brand': 'bg-brand-50 text-brand-700 ring-1 ring-brand-200 hover:bg-brand-100',
    'violet': 'bg-violet-100 text-violet-700 ring-1 ring-violet-200 hover:bg-violet-200',
    'teal': 'bg-teal-100 text-teal-700 ring-1 ring-teal-200 hover:bg-teal-200',
} %}

<div class="dash-panel mb-6 p-4 sm:p-5">
    <p class="mb-2.5 text-xs font-bold uppercase tracking-wide text-slate-500">Needs your attention</p>
    {% if attention_items %}
    <div class="flex max-w-full flex-wrap gap-1.5">
        {% for item in attention_items[:6] %}
        <a href="{{ url(item.href_name) }}"
           class="inline-flex max-w-[14rem] items-center gap-1.5 truncate rounded-full px-2.5 py-1 text-xs font-semibold transition {{ tone_map.get(item.tone, 'bg-slate-100 text-slate-600 ring-1 ring-slate-200') }}">
            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-current opacity-80"></span>
            <span class="truncate">{{ item.label }}</span>
        </a>
        {% endfor %}
        {% if attention_items|length > 6 %}
        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-500">+{{ attention_items|length - 6 }}</span>
        {% endif %}
    </div>
    {% else %}
    <p class="text-xs font-medium text-slate-400">All clear — nothing urgent.</p>
    {% endif %}
</div>

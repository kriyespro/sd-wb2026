{% if error %}
<p class="text-xs font-medium text-red-600">{{ error }}</p>
{% else %}
<form id="rzp-verify-form-{{ dom_id }}" method="post" action="{{ verify_url }}" class="hidden">
    <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
    <input type="hidden" name="razorpay_order_id" value="{{ order_id }}">
    <input type="hidden" name="razorpay_payment_id" id="rzp-payment-id-{{ dom_id }}">
    <input type="hidden" name="razorpay_signature" id="rzp-signature-{{ dom_id }}">
</form>
<script>
(function () {
    var options = {
        key: {{ key_id|tojson }},
        amount: {{ amount_paise }},
        currency: 'INR',
        order_id: {{ order_id|tojson }},
        name: 'Winning Blueprints',
        description: {{ description|tojson }},
        prefill: {
            name: {{ prefill_name|tojson }},
            email: {{ prefill_email|tojson }},
        },
        theme: { color: '#1e3a6e' },
        handler: function (response) {
            document.getElementById('rzp-payment-id-{{ dom_id }}').value = response.razorpay_payment_id;
            document.getElementById('rzp-signature-{{ dom_id }}').value = response.razorpay_signature;
            document.getElementById('rzp-verify-form-{{ dom_id }}').submit();
        },
    };
    function launch() {
        var rzp = new Razorpay(options);
        rzp.open();
    }
    if (typeof Razorpay === 'undefined') {
        var poll = setInterval(function () {
            if (typeof Razorpay !== 'undefined') {
                clearInterval(poll);
                launch();
            }
        }, 100);
    } else {
        launch();
    }
})();
</script>
{% endif %}

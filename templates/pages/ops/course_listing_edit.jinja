{% extends "layouts/dashboard.jinja" %}

{% block dashboard_content %}
<section class="relative mb-6 overflow-hidden rounded-[1.75rem] bg-ink-900 px-6 py-7 text-white sm:px-8">
    <div class="pointer-events-none absolute -right-12 -top-12 h-40 w-40 rounded-full bg-violet-500/25 blur-3xl"></div>
    <div class="relative flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <span class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-300">Academy</span>
            <h2 class="mt-2 font-display text-2xl font-bold">Edit course</h2>
            <p class="mt-1 max-w-xl text-sm text-slate-300">{{ course_listing.title }}</p>
        </div>
        <a href="{{ url('operations:course_listings') }}"
           class="rounded-full border border-white/20 bg-white/5 px-4 py-2 text-xs font-bold text-white transition hover:bg-white/10">
            ← All courses
        </a>
    </div>
</section>

<div class="dash-panel p-6">
    <form method="post" class="grid gap-4">
        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
        {% include "partials/ops/_course_listing_form_fields.jinja" %}
        <div>
            <button type="submit" class="btn-primary !px-6 !py-2.5 text-sm">Save changes</button>
        </div>
    </form>
</div>
{% endblock %}

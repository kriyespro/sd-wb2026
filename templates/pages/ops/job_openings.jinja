{% extends "layouts/dashboard.jinja" %}

{% block dashboard_content %}
<section class="relative mb-6 overflow-hidden rounded-[1.75rem] bg-ink-900 px-6 py-7 text-white sm:px-8">
    <div class="pointer-events-none absolute -right-12 -top-12 h-40 w-40 rounded-full bg-violet-500/25 blur-3xl"></div>
    <div class="relative flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <span class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-300">Hiring desk</span>
            <h2 class="mt-2 font-display text-2xl font-bold">Job Openings</h2>
            <p class="mt-1 max-w-xl text-sm text-slate-300">
                What's live on the public careers page. Add a role below — it appears on
                <a href="{{ url('website:careers') }}" target="_blank" rel="noopener" class="underline hover:text-white">/careers/</a>
                immediately. Turn one off to pull it without deleting it.
            </p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a href="{{ url('operations:job_applications') }}"
               class="rounded-full border border-white/20 bg-white/5 px-4 py-2 text-xs font-bold text-white transition hover:bg-white/10">
                Applications →
            </a>
            <a href="{{ url('operations:dashboard') }}"
               class="rounded-full border border-white/20 bg-white/5 px-4 py-2 text-xs font-bold text-white transition hover:bg-white/10">
                ← Mission Control
            </a>
        </div>
    </div>
</section>

<div class="dash-panel mb-6 p-6">
    <h3 class="font-display text-lg font-bold text-ink-900">Add a role</h3>
    <form method="post" action="{{ url('operations:job_opening_add') }}" class="mt-4 grid gap-3 sm:grid-cols-2">
        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
        <div class="sm:col-span-1">
            <label class="mb-1 block text-xs font-semibold text-slate-600">Title</label>
            {{ form.title }}
            {% if show_errors %}{% for e in form.title.errors %}<p class="mt-1 text-xs text-red-600">{{ e }}</p>{% endfor %}{% endif %}
        </div>
        <div class="sm:col-span-1">
            <label class="mb-1 block text-xs font-semibold text-slate-600">Department</label>
            {{ form.department }}
            {% if show_errors %}{% for e in form.department.errors %}<p class="mt-1 text-xs text-red-600">{{ e }}</p>{% endfor %}{% endif %}
        </div>
        <div class="sm:col-span-1">
            <label class="mb-1 block text-xs font-semibold text-slate-600">Type</label>
            {{ form.job_type }}
        </div>
        <div class="sm:col-span-1">
            <label class="mb-1 block text-xs font-semibold text-slate-600">Location</label>
            {{ form.location }}
        </div>
        <div class="sm:col-span-2">
            <label class="mb-1 block text-xs font-semibold text-slate-600">Summary</label>
            {{ form.summary }}
            {% if show_errors %}{% for e in form.summary.errors %}<p class="mt-1 text-xs text-red-600">{{ e }}</p>{% endfor %}{% endif %}
        </div>
        <div class="sm:col-span-1">
            <label class="mb-1 block text-xs font-semibold text-slate-600">Tags</label>
            {{ form.tags }}
        </div>
        <div class="flex items-end gap-2 sm:col-span-1">
            <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
                {{ form.is_active }} Live on careers page
            </label>
        </div>
        <div class="sm:col-span-2">
            <button type="submit" class="btn-primary !px-6 !py-2.5 text-sm">Add role</button>
        </div>
    </form>
</div>

{% if pending_openings %}
<div class="dash-panel mb-6 overflow-hidden border-amber-200">
    <div class="border-b border-amber-100 bg-amber-50/60 px-5 py-3">
        <h3 class="font-display text-sm font-bold text-ink-900">Pending review — {{ pending_openings|length }}</h3>
        <p class="text-xs text-slate-600">Submitted by outside companies via /careers/post-a-job/. Not visible on the site until approved.</p>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full min-w-[860px] text-left text-sm">
            <thead class="border-b border-slate-100 bg-slate-50/80 text-xs uppercase tracking-[0.14em] text-slate-500">
                <tr>
                    <th class="px-5 py-3.5 font-semibold">Role</th>
                    <th class="px-4 py-3.5 font-semibold">Company / Contact</th>
                    <th class="px-4 py-3.5 font-semibold">Submitted</th>
                    <th class="px-5 py-3.5 font-semibold">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                {% for opening in pending_openings %}
                {% include "partials/ops/_job_opening_pending_row.jinja" %}
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

{% if openings %}
<div class="dash-panel overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full min-w-[860px] text-left text-sm">
            <thead class="border-b border-slate-100 bg-slate-50/80 text-xs uppercase tracking-[0.14em] text-slate-500">
                <tr>
                    <th class="px-5 py-3.5 font-semibold">Role</th>
                    <th class="px-4 py-3.5 font-semibold">Department</th>
                    <th class="px-4 py-3.5 font-semibold">Type</th>
                    <th class="px-4 py-3.5 font-semibold">Location</th>
                    <th class="px-4 py-3.5 font-semibold">Status</th>
                    <th class="px-5 py-3.5 font-semibold">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                {% for opening in openings %}
                {% include "partials/ops/_job_opening_row.jinja" %}
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% else %}
<div class="dash-panel p-12 text-center">
    <p class="font-display text-lg font-semibold text-ink-900">No roles yet</p>
    <p class="mt-2 text-sm text-slate-500">Add one above to make it live on /careers/.</p>
</div>
{% endif %}
{% endblock %}

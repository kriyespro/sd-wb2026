{% extends "layouts/dashboard.jinja" %}

{% block dashboard_content %}
<section class="relative mb-6 overflow-hidden rounded-[1.75rem] bg-ink-900 px-6 py-7 text-white sm:px-8">
    <div class="pointer-events-none absolute -right-12 -top-12 h-40 w-40 rounded-full bg-violet-500/25 blur-3xl"></div>
    <div class="relative flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <span class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-300">Hiring desk</span>
            <h2 class="mt-2 font-display text-2xl font-bold">Edit role</h2>
            <p class="mt-1 max-w-xl text-sm text-slate-300">{{ opening.title }}</p>
        </div>
        <a href="{{ url('operations:job_openings') }}"
           class="rounded-full border border-white/20 bg-white/5 px-4 py-2 text-xs font-bold text-white transition hover:bg-white/10">
            ← All openings
        </a>
    </div>
</section>

<div class="dash-panel p-6">
    <form method="post" class="grid gap-3 sm:grid-cols-2">
        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">

        {% if show_errors and form.errors %}
        <div class="sm:col-span-2 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            Please fix the highlighted fields and try again.
        </div>
        {% endif %}

        <div class="sm:col-span-1">
            <label class="mb-1 block text-xs font-semibold text-slate-600">Title</label>
            {{ form.title }}
            {% if show_errors %}{% for e in form.title.errors %}<p class="mt-1 text-xs text-red-600">{{ e }}</p>{% endfor %}{% endif %}
        </div>
        <div class="sm:col-span-1">
            <label class="mb-1 block text-xs font-semibold text-slate-600">Department</label>
            {{ form.department }}
            {% if show_errors %}{% for e in form.department.errors %}<p class="mt-1 text-xs text-red-600">{{ e }}</p>{% endfor %}{% endif %}
        </div>
        <div class="sm:col-span-1">
            <label class="mb-1 block text-xs font-semibold text-slate-600">Type</label>
            {{ form.job_type }}
        </div>
        <div class="sm:col-span-1">
            <label class="mb-1 block text-xs font-semibold text-slate-600">Location</label>
            {{ form.location }}
        </div>
        <div class="sm:col-span-2">
            <label class="mb-1 block text-xs font-semibold text-slate-600">Summary</label>
            {{ form.summary }}
            {% if show_errors %}{% for e in form.summary.errors %}<p class="mt-1 text-xs text-red-600">{{ e }}</p>{% endfor %}{% endif %}
        </div>
        <div class="sm:col-span-1">
            <label class="mb-1 block text-xs font-semibold text-slate-600">Tags</label>
            {{ form.tags }}
        </div>
        <div class="flex items-end gap-2 sm:col-span-1">
            <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
                {{ form.is_active }} Live on careers page
            </label>
        </div>

        <div class="sm:col-span-2 mt-2 border-t border-slate-100 pt-4">
            <h4 class="text-xs font-semibold uppercase tracking-wide text-slate-500">External posting details</h4>
            <p class="mt-1 text-xs text-slate-400">Blank company name = shown as a Winning Blueprints role.</p>
        </div>
        <div class="sm:col-span-1">
            <label class="mb-1 block text-xs font-semibold text-slate-600">Company name</label>
            {{ form.company_name }}
        </div>
        <div class="sm:col-span-1">
            <label class="mb-1 block text-xs font-semibold text-slate-600">Contact name</label>
            {{ form.contact_name }}
        </div>
        <div class="sm:col-span-1">
            <label class="mb-1 block text-xs font-semibold text-slate-600">Contact email</label>
            {{ form.contact_email }}
        </div>
        <div class="sm:col-span-1">
            <label class="mb-1 block text-xs font-semibold text-slate-600">Contact phone</label>
            {{ form.contact_phone }}
        </div>

        <div class="sm:col-span-2 mt-2">
            <button type="submit" class="btn-primary !px-6 !py-2.5 text-sm">Save changes</button>
        </div>
    </form>
</div>
{% endblock %}

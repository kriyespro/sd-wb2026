{% extends "layouts/dashboard.jinja" %}

{% block dashboard_content %}
{% if invoices %}
<div class="dash-panel overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-slate-50 text-left text-slate-500">
            <tr>
                <th class="px-6 py-3 font-medium">Invoice</th>
                <th class="px-6 py-3 font-medium">Description</th>
                <th class="px-6 py-3 font-medium">Amount</th>
                <th class="px-6 py-3 font-medium">Status</th>
                <th class="px-6 py-3 font-medium">Due date</th>
                <th class="px-6 py-3 font-medium"></th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            {% for invoice in invoices %}
            <tr>
                <td class="px-6 py-4 font-medium text-slate-700">{{ invoice.invoice_number }}</td>
                <td class="px-6 py-4 text-slate-600">
                    {{ invoice.title }}
                    {% if invoice.project %}<span class="block text-xs text-slate-500">{{ invoice.project.name }}</span>{% endif %}
                </td>
                <td class="px-6 py-4 font-display font-semibold text-ink-900">₹{{ '{:,.0f}'.format(invoice.amount) }}</td>
                <td class="px-6 py-4">
                    <span class="dash-badge
                        {% if invoice.status == 'paid' %}bg-emerald-100 text-emerald-700
                        {% elif invoice.status == 'overdue' %}bg-red-100 text-red-700
                        {% else %}bg-brand-50 text-brand-700{% endif %}">
                        {{ invoice.get_status_display() }}
                    </span>
                </td>
                <td class="px-6 py-4 text-slate-500">{{ invoice.due_date.strftime('%d %b %Y') }}</td>
                <td class="px-6 py-4 text-right">
                    {% if invoice.status != 'paid' %}
                    <button
                        hx-post="{{ url('clients:invoice_pay', kwargs={'pk': invoice.pk}) }}"
                        hx-target="#checkout-launch-{{ invoice.pk }}"
                        hx-swap="innerHTML"
                        class="rounded-full bg-brand-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-brand-700">
                        Pay Now
                    </button>
                    <div id="checkout-launch-{{ invoice.pk }}"></div>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% include "components/pagination.jinja" %}
{% else %}
<div class="dash-panel p-12 text-center">
    <div class="text-3xl">🧾</div>
    <h3 class="mt-3 font-semibold text-ink-900">No invoices yet</h3>
    <p class="mt-2 text-sm text-slate-500">Your account manager will share invoices here as projects progress.</p>
</div>
{% endif %}
{% endblock %}

{% extends "layouts/dashboard.jinja" %}

{% block dashboard_content %}
<div class="max-w-2xl">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="font-semibold text-brand-950">Post a Job</h2>
        <p class="mt-1 text-sm text-slate-500">
            Advertise your open role to the Winning Blueprints talent network. Our team reviews every posting
            before it goes live on <a href="{{ url('website:careers') }}" target="_blank" rel="noopener" class="font-semibold text-brand-600 hover:underline">/careers/</a>.
        </p>

        {% if submitted %}
        <div class="mt-5 rounded-xl border border-emerald-200 bg-emerald-50 p-6 text-center">
            <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-emerald-500 text-lg text-white">✓</div>
            <h3 class="mt-3 font-semibold text-ink-900">Submitted for review</h3>
            <p class="mt-1 text-sm text-slate-600">We'll publish it once approved.</p>
        </div>
        {% else %}
        <form method="post" class="mt-4 space-y-4">
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">

            {% if show_errors and form.errors %}
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                Please fix the highlighted fields and try again.
            </div>
            {% endif %}

            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">Company name *</label>
                    {{ form.company_name }}
                    {% if show_errors and form.company_name.errors %}<p class="mt-1 text-xs text-red-600">{{ form.company_name.errors[0] }}</p>{% endif %}
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">Your name *</label>
                    {{ form.contact_name }}
                    {% if show_errors and form.contact_name.errors %}<p class="mt-1 text-xs text-red-600">{{ form.contact_name.errors[0] }}</p>{% endif %}
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">Contact email *</label>
                    {{ form.contact_email }}
                    {% if show_errors and form.contact_email.errors %}<p class="mt-1 text-xs text-red-600">{{ form.contact_email.errors[0] }}</p>{% endif %}
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">Contact phone *</label>
                    {{ form.contact_phone }}
                    {% if show_errors and form.contact_phone.errors %}<p class="mt-1 text-xs text-red-600">{{ form.contact_phone.errors[0] }}</p>{% endif %}
                </div>
            </div>

            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Job title *</label>
                {{ form.title }}
                {% if show_errors and form.title.errors %}<p class="mt-1 text-xs text-red-600">{{ form.title.errors[0] }}</p>{% endif %}
            </div>

            <div class="grid gap-4 sm:grid-cols-3">
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">Category *</label>
                    {{ form.department }}
                    {% if show_errors and form.department.errors %}<p class="mt-1 text-xs text-red-600">{{ form.department.errors[0] }}</p>{% endif %}
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">Type *</label>
                    {{ form.job_type }}
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">Location *</label>
                    {{ form.location }}
                    {% if show_errors and form.location.errors %}<p class="mt-1 text-xs text-red-600">{{ form.location.errors[0] }}</p>{% endif %}
                </div>
            </div>

            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Role summary *</label>
                {{ form.summary }}
                {% if show_errors and form.summary.errors %}<p class="mt-1 text-xs text-red-600">{{ form.summary.errors[0] }}</p>{% endif %}
            </div>

            <div>
                <label class="mb-1 block text-sm font-medium text-slate-700">Tags</label>
                {{ form.tags }}
            </div>

            <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700">
                Submit for review
            </button>
        </form>
        {% endif %}
    </div>
</div>
{% endblock %}

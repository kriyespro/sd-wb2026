{% extends "layouts/dashboard.jinja" %}

{% block dashboard_content %}
{% set level_colors = {
    'excellent': ('text-emerald-600', '#10b981'),
    'good': ('text-brand-600', '#1e3a6e'),
    'developing': ('text-amber-600', '#c9a227'),
    'at_risk': ('text-red-600', '#ef4444'),
} %}
{% set ring_color = level_colors[score_level][1] %}
{% set ring_offset = (339.292 - (daily_score / 100 * 339.292))|round(1) %}

<div class="mb-6 grid gap-4 sm:grid-cols-3">
    <div class="dash-panel col-span-1 flex items-center gap-4 p-5">
        <div class="relative h-16 w-16 shrink-0">
            <svg width="64" height="64" viewBox="0 0 120 120" class="-rotate-90">
                <circle cx="60" cy="60" r="54" fill="none" stroke="#f1f5f9" stroke-width="14"/>
                <circle cx="60" cy="60" r="54" fill="none" stroke="{{ ring_color }}" stroke-width="14"
                    stroke-linecap="round" stroke-dasharray="339.292" stroke-dashoffset="{{ ring_offset }}"/>
            </svg>
            <div class="absolute inset-0 flex items-center justify-center font-display text-sm font-bold {{ level_colors[score_level][0] }}">{{ daily_score }}</div>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500">Today's Score</p>
            <p class="text-xs text-slate-500">out of 100</p>
        </div>
    </div>
    {% set label = 'Current Streak' %}{% set value = streak ~ (' day' if streak == 1 else ' days') %}{% set value_color = 'text-brand-600' %}{% include "partials/dashboard/_stat_card.jinja" %}
    {% set label = 'Journal Entries' %}{% set value = pillar_totals.notes %}{% set value_color = 'text-ink-900' %}{% include "partials/dashboard/_stat_card.jinja" %}
</div>

<div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {% for pillar in ['learn', 'teach', 'field', 'earn'] %}
    <div class="pillar-card pillar-{{ pillar }}">
        <span class="pillar-chip pillar-{{ pillar }}"><span class="pillar-dot pillar-{{ pillar }}"></span>{{ pillar|capitalize }}</span>
        <p class="mt-2 font-display text-2xl font-bold text-ink-900">{{ pillar_totals[pillar] }}<span class="text-sm text-slate-500"> total</span></p>
    </div>
    {% endfor %}
</div>

<div class="dash-panel mb-6">
    {% set title = 'Last 30 days' %}{% include "partials/dashboard/_panel_header.jinja" %}
    <div class="p-5 sm:p-6">
        <div class="flex flex-wrap gap-1.5">
            {% for day in score_history %}
            <div class="heatmap-cell
                {% if day.score == 0 %}bg-slate-100
                {% elif day.score < 50 %}bg-brand-200
                {% elif day.score < 70 %}bg-brand-400
                {% elif day.score < 85 %}bg-brand-600
                {% else %}bg-brand-800{% endif %}"
                title="{{ day.date.strftime('%d %b %Y') }} — score {{ day.score }}/100"></div>
            {% endfor %}
        </div>
        <div class="mt-4 flex items-center gap-2 text-xs text-slate-500">
            <span>Less</span>
            <div class="heatmap-cell bg-slate-100"></div>
            <div class="heatmap-cell bg-brand-200"></div>
            <div class="heatmap-cell bg-brand-400"></div>
            <div class="heatmap-cell bg-brand-600"></div>
            <div class="heatmap-cell bg-brand-800"></div>
            <span>More</span>
        </div>
    </div>
</div>

<div class="grid gap-6 lg:grid-cols-3">
    <div class="dash-panel lg:col-span-2">
        {% set title = 'Activity timeline' %}{% include "partials/dashboard/_panel_header.jinja" %}
        <div class="p-5 sm:p-6">
            {% if activity_feed %}
            <ul class="space-y-4">
                {% for item in activity_feed %}
                <li class="flex items-start gap-3">
                    <span class="pillar-dot pillar-{{ item.pillar }} mt-1.5"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-center gap-2">
                            <p class="font-medium text-ink-900">{{ item.title }}</p>
                            <span class="pillar-chip pillar-{{ item.pillar }}">{{ item.pillar|capitalize }}</span>
                        </div>
                        {% if item.detail %}<p class="mt-0.5 text-sm text-slate-600">{{ item.detail }}</p>{% endif %}
                        <p class="mt-0.5 text-xs text-slate-500">{{ item.timestamp.strftime('%d %b %Y, %H:%M') }}</p>
                    </div>
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <p class="text-sm text-slate-500">Nothing logged yet. Submit an assignment, teach a session, log a lead, complete a task, or add a journal entry.</p>
            {% endif %}
        </div>
    </div>

    <div class="dash-panel">
        {% set title = 'Log an activity' %}{% include "partials/dashboard/_panel_header.jinja" %}
        <div class="p-5 sm:p-6">
            <form method="post" action="{{ url('academy_dashboard:activity_add') }}" class="space-y-3">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                <input type="hidden" name="next" value="progress">
                {{ activity_form.pillar }}
                {{ activity_form.title }}
                {{ activity_form.details }}
                <button type="submit" class="btn-primary w-full py-2.5 text-sm">Add to my journal</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}

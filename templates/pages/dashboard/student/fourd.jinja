{% extends "layouts/dashboard.jinja" %}

{% block dashboard_content %}
{% set level_colors = {
    'excellent': ('text-emerald-600', '#10b981'),
    'good': ('text-brand-600', '#1e3a6e'),
    'developing': ('text-amber-600', '#c9a227'),
    'at_risk': ('text-red-600', '#ef4444'),
} %}
{% set level_labels = {
    'excellent': '🟢 Excellent',
    'good': '🔵 Good',
    'developing': '🟡 Developing',
    'at_risk': '🔴 At Risk',
} %}
{% set ring_color = level_colors[score_level][1] %}
{% set ring_offset = (339.292 - (daily_score / 100 * 339.292))|round(1) %}

<div class="dash-panel mb-6 p-5 sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-6">
        <div class="flex items-center gap-5">
            <div class="relative h-[110px] w-[110px] shrink-0">
                <svg width="110" height="110" viewBox="0 0 120 120" class="-rotate-90">
                    <circle cx="60" cy="60" r="54" fill="none" stroke="#f1f5f9" stroke-width="10"/>
                    <circle cx="60" cy="60" r="54" fill="none" stroke="{{ ring_color }}" stroke-width="10"
                        stroke-linecap="round" stroke-dasharray="339.292" stroke-dashoffset="{{ ring_offset }}"/>
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span class="font-display text-3xl font-bold {{ level_colors[score_level][0] }}">{{ daily_score }}</span>
                    <span class="text-xs text-slate-500">/ 100</span>
                </div>
            </div>
            <div>
                <p class="text-sm font-medium text-slate-500">Today's 4D Score</p>
                <p class="mt-0.5 text-sm font-semibold {{ level_colors[score_level][0] }}">{{ level_labels[score_level] }}</p>
                <a href="{{ url('academy_dashboard:progress') }}" class="mt-2 inline-block text-xs font-semibold text-brand-600 hover:text-brand-700">View my progress →</a>
            </div>
        </div>
        <div class="text-right">
            <p class="text-sm font-medium text-slate-500">7-day average</p>
            <p class="mt-1 font-display text-2xl font-bold text-ink-900">{{ rolling_average }}</p>
        </div>
    </div>
</div>

<div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {% for pillar, weight in pillar_weights.items() %}
    {% set done = pillar_status[pillar] %}
    <div class="pillar-card pillar-{{ pillar }} {% if done %}bg-emerald-50/30{% endif %}">
        <div class="flex items-center justify-between">
            <span class="pillar-chip pillar-{{ pillar }}">
                <span class="pillar-dot pillar-{{ pillar }}"></span>{{ pillar|capitalize }}
            </span>
            <span class="dash-badge {% if done %}bg-emerald-100 text-emerald-700{% else %}bg-slate-100 text-slate-500{% endif %}">
                {% if done %}✓ Done{% else %}Pending{% endif %}
            </span>
        </div>
        <p class="mt-2 font-display text-2xl font-bold text-ink-900">{{ weight }}<span class="text-sm text-slate-500"> pts</span></p>
        {% if pillar == 'learn' %}<a href="{{ url('academy_dashboard:assignments') }}" class="mt-2 inline-block text-xs font-semibold text-brand-600 hover:text-brand-700">Submit an assignment →</a>
        {% elif pillar == 'teach' %}<a href="{{ url('academy_dashboard:teaching') }}" class="mt-2 inline-block text-xs font-semibold text-brand-600 hover:text-brand-700">Log a teaching session →</a>
        {% elif pillar == 'field' %}<a href="{{ url('academy_dashboard:field_leads') }}" class="mt-2 inline-block text-xs font-semibold text-brand-600 hover:text-brand-700">Log field activity →</a>
        {% else %}<a href="{{ url('academy_dashboard:tasks') }}" class="mt-2 inline-block text-xs font-semibold text-brand-600 hover:text-brand-700">Complete an earn task →</a>
        {% endif %}
    </div>
    {% endfor %}
</div>

<div class="grid gap-6 lg:grid-cols-3">
    <div class="dash-panel lg:col-span-2">
        {% set title = "Today's open tasks" %}{% include "partials/dashboard/_panel_header.jinja" %}
        <div class="p-5 sm:p-6">
            {% if today_tasks %}
            <ul class="space-y-2">
                {% for task in today_tasks %}
                <li class="flex items-center justify-between gap-3 rounded-xl border border-slate-100 px-3 py-2.5 text-sm">
                    <div class="flex items-center gap-2">
                        <span class="pillar-chip pillar-{{ task.stage }}"><span class="pillar-dot pillar-{{ task.stage }}"></span>{{ task.get_stage_display() }}</span>
                        <span class="text-slate-700">{{ task.title }}</span>
                    </div>
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <p class="text-sm text-slate-500">No stage-tagged tasks open right now.</p>
            {% endif %}

            {% if recent_activity %}
            <p class="mb-2 mt-6 text-xs font-semibold uppercase tracking-wider text-slate-500">Recent activity</p>
            <ul class="space-y-2">
                {% for item in recent_activity %}
                <li class="flex items-start gap-2.5 text-sm">
                    <span class="pillar-dot pillar-{{ item.pillar }} mt-1.5"></span>
                    <div class="min-w-0">
                        <p class="truncate text-slate-700">{{ item.title }}</p>
                        <p class="text-xs text-slate-500">{{ item.timestamp.strftime('%d %b, %H:%M') }}</p>
                    </div>
                </li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>
    </div>

    <div class="dash-panel">
        {% set title = 'Log an activity' %}{% include "partials/dashboard/_panel_header.jinja" %}
        <div class="p-5 sm:p-6">
            <form method="post" action="{{ url('academy_dashboard:activity_add') }}" class="space-y-3">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                <input type="hidden" name="next" value="fourd">
                {{ activity_form.pillar }}
                {{ activity_form.title }}
                {{ activity_form.details }}
                <button type="submit" class="btn-primary w-full py-2.5 text-sm">Add to my journal</button>
            </form>
            <p class="mt-3 text-xs text-slate-500">This is your own notes — it doesn't affect your score, which is based on real submissions, sessions, leads and completed tasks.</p>

            <div class="mt-6 border-t border-slate-100 pt-6">
                <label class="mb-1 block text-sm font-medium text-slate-700">Today's reflection</label>
                <form method="post" action="{{ url('academy_dashboard:fourd_submit') }}" class="space-y-3">
                    <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
                    {{ form.notes }}
                    <button type="submit" class="btn-outline w-full py-2 text-xs">Submit Today's 4D</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

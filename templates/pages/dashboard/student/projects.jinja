{% extends "layouts/dashboard.jinja" %}

{% block dashboard_content %}
{% if projects %}
<div class="grid gap-4 md:grid-cols-2">
    {% for project in projects %}
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
            <span class="rounded-full bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700">{{ project.get_project_type_display() }}</span>
            <span class="rounded-full px-2 py-0.5 text-xs font-medium
                {% if project.status == 'completed' %}bg-green-100 text-green-700{% else %}bg-blue-100 text-blue-700{% endif %}">
                {{ project.get_status_display() }}
            </span>
        </div>
        <h3 class="mt-3 font-semibold text-brand-950">{{ project.title }}</h3>
        <p class="mt-2 text-sm text-slate-600">{{ project.description }}</p>
        {% if project.project_type == 'real' %}
        <form method="post" action="{{ url('academy_dashboard:project_update', kwargs={'pk': project.id}) }}" class="mt-4 space-y-2 border-t border-slate-100 pt-4">
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
            <label class="block text-xs font-medium text-slate-500">Client</label>
            <input type="text" name="client_name" value="{{ project.client_name }}" class="wb-input py-2 text-sm" placeholder="Client name">
            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="block text-xs font-medium text-slate-500">Project value (₹)</label>
                    <input type="number" name="project_value" value="{{ project.project_value }}" class="wb-input py-2 text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-500">Collected (₹)</label>
                    <input type="number" name="revenue_collected" value="{{ project.revenue_collected }}" class="wb-input py-2 text-sm">
                </div>
            </div>
            <label class="block text-xs font-medium text-slate-500">Payment status</label>
            <select name="payment_status" class="wb-input py-2 text-sm">
                {% for value, label in project.PAYMENT_CHOICES %}
                <option value="{{ value }}" {% if project.payment_status == value %}selected{% endif %}>{{ label }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="btn-primary w-full py-2 text-xs">Save</button>
        </form>
        {% endif %}
    </div>
    {% endfor %}
</div>
{% else %}
<div class="rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center">
    <p class="text-slate-500">No projects assigned yet.</p>
</div>
{% endif %}
{% endblock %}

{% extends "base.jinja" %}

{% block content %}
<section class="bg-slate-50 py-12 sm:py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <p class="text-sm text-slate-500">
            <a href="{{ url('academy:course_detail', kwargs={'slug': course.slug}) }}" class="hover:text-brand-700">{{ course.title }}</a> / Checkout
        </p>
        <h1 class="mt-2 font-display text-3xl font-bold text-ink-900">Checkout</h1>

        <div class="mt-8 grid gap-8 lg:grid-cols-5">
            <!-- ORDER SUMMARY -->
            <div class="lg:col-span-3">
                <div class="rounded-2xl border border-slate-200 bg-white p-6">
                    <div class="flex gap-4">
                        <img src="{{ course.image }}" alt="{{ course.title }}" class="h-20 w-28 shrink-0 rounded-lg object-cover">
                        <div>
                            <h2 class="font-display font-bold text-ink-900">{{ course.title }}</h2>
                            <p class="mt-1 text-sm text-slate-500">{{ course.level }} · {{ course.duration }} · {{ course.format }}</p>
                        </div>
                    </div>
                    <ul class="mt-5 space-y-2 border-t border-slate-100 pt-5 text-sm text-slate-600">
                        {% for item in course.includes %}
                        <li class="flex gap-2"><span class="text-gold-500">✓</span>{{ item }}</li>
                        {% endfor %}
                    </ul>
                    <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-5">
                        <span class="text-sm font-medium text-slate-500">Total due</span>
                        <span class="font-display text-2xl font-bold text-brand-700">{{ course.price }}</span>
                    </div>
                </div>

                <div class="mt-4 flex items-center gap-2 text-xs text-slate-500">
                    <span>🔒</span>
                    <span>Secure payment powered by Razorpay. Card, UPI, netbanking &amp; wallets accepted.</span>
                </div>
            </div>

            <!-- CONTACT + PAY -->
            <div class="lg:col-span-2">
                <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg">
                    <h3 class="font-display font-bold text-ink-900">Your details</h3>
                    <p class="mt-1 text-xs text-slate-500">Optional — used for your receipt and enrollment confirmation. You can skip straight to payment.</p>

                    <form id="checkout-contact-form" class="mt-4 space-y-3">
                        <input type="text" name="name" value="{{ prefill_name }}" placeholder="Full name" class="wb-input">
                        <input type="email" name="email" value="{{ prefill_email }}" placeholder="you@company.com" class="wb-input">
                        <input type="text" name="phone" value="{{ prefill_phone }}" placeholder="+91 90000 00000" class="wb-input">
                    </form>

                    <div class="mt-5 space-y-2">
                        <button type="button"
                                hx-post="{{ url('academy:enroll_pay', kwargs={'slug': course.slug}) }}"
                                hx-include="#checkout-contact-form"
                                hx-target="#checkout-launch" hx-swap="innerHTML" hx-disabled-elt="this"
                                class="btn-gold w-full text-center">Pay {{ course.price }} with Razorpay</button>
                    </div>
                    <p class="mt-3 text-center text-xs text-slate-400">Express checkout — pay now, we'll email your receipt.</p>
                    <div id="checkout-launch" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
